# Create a local .env with: python scripts/create_env.py
# All passwords are generated as URL-safe hexadecimal secrets by that script.
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_RUNTIME_PASSWORD=replace-with-generated-secret
DATABASE_ORM_ADMIN_PASSWORD=replace-with-generated-secret
AUTH_JWT_HS256_SECRET=replace-with-generated-secret
AUTH_JWT_ISSUER=queryimmune-auth
AUTH_JWT_AUDIENCE=queryimmune-api
AI_PROVIDER=demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RESPONSE_BYTES=16384
QUERYIMMUNE_RESULT_LIMIT=100
QUERYIMMUNE_REVIEW_LIMIT=25
LOG_LEVEL=INFO
