# Bootstrap URL is used only by migration/seed commands. For a fresh local
# database, connect as a PostgreSQL superuser (the installer-created postgres
# account is typical). A custom bootstrap account needs database CREATE access,
# authority to create/alter/grant the QueryImmune roles, and membership/admin
# rights sufficient to SET ROLE qi_owner. Do not use this URL for the API.
POSTGRES_PASSWORD=replace-me
DATABASE_ADMIN_URL=postgresql://queryimmune_bootstrap:replace-me@localhost:5433/queryimmune
# Runtime app connection; provisioned as queryimmune_runtime by queryimmune_db.migrate.
DATABASE_URL=postgresql://queryimmune_runtime:replace-me@localhost:5433/queryimmune
# Runtime role password used only during explicit role provisioning.
DATABASE_RUNTIME_PASSWORD=replace-me
# Separate appointment-administration ORM login; never use this for generated SQL.
DATABASE_ORM_ADMIN_PASSWORD=replace-me
# Local Compose builds this URL from DATABASE_ORM_ADMIN_PASSWORD.
DATABASE_ORM_ADMIN_URL=postgresql+psycopg://queryimmune_orm_admin:replace-me@localhost:5433/queryimmune
# JWT signing and verification secret for short-lived first-party login tokens.
AUTH_JWT_HS256_SECRET=replace-this-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=queryimmune-auth
AUTH_JWT_AUDIENCE=queryimmune-api
# One local demo login mapped to an existing seeded database identity.
# Generate a PBKDF2 hash with: python -m queryimmune_db.api.password_hash
AUTH_LOGIN_USERNAME=replace-me
AUTH_LOGIN_PASSWORD_HASH=
AUTH_LOGIN_SUBJECT=demo:dr-ada
LOG_LEVEL=INFO
QUERYIMMUNE_RESULT_LIMIT=100
QUERYIMMUNE_REVIEW_LIMIT=25
# Use demo for deterministic fixtures that still traverse validation and PostgreSQL,
# or openai-compatible with the settings below. Disabled remains fail-closed.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RESPONSE_BYTES=16384
