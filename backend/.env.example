# Bootstrap URL is used only by migration/seed commands. It needs CREATEDB/CREATEROLE
# or must connect to a database and roles already provisioned by an administrator.
POSTGRES_PASSWORD=replace-me
DATABASE_ADMIN_URL=postgresql://queryimmune_bootstrap:replace-me@localhost:5432/queryimmune
# Runtime app connection; provisioned as queryimmune_runtime by scripts/bootstrap.py.
DATABASE_URL=postgresql://queryimmune_runtime:replace-me@localhost:5432/queryimmune
# Runtime role password used only during explicit role provisioning.
DATABASE_RUNTIME_PASSWORD=replace-me
# JWT verification only; tokens are issued by a trusted identity provider, never this API.
AUTH_JWT_HS256_SECRET=replace-this-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=queryimmune-auth
AUTH_JWT_AUDIENCE=queryimmune-api
LOG_LEVEL=INFO
QUERYIMMUNE_RESULT_LIMIT=100
QUERYIMMUNE_REVIEW_LIMIT=25
# Natural-language mode is fail-closed until an explicit provider is configured.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RESPONSE_BYTES=16384
